{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "kcenon-database-system",
  "version": "0.1.0",
  "port-version": 0,
  "description": "Advanced C++20 Database System with Multi-Backend Support",
  "homepage": "https://github.com/kcenon/database_system",
  "license": "BSD-3-Clause",
  "supports": "!(uwp | xbox)",
  "dependencies": [
    {
      "name": "fmt",
      "version>=": "10.2.1"
    },
    "asio"
  ],
  "features": {
    "ecosystem": {
      "description": "Enable kcenon ecosystem integration (requires ecosystem packages in vcpkg registry)",
      "dependencies": [
        "kcenon-common-system",
        "kcenon-thread-system",
        "kcenon-logger-system",
        "kcenon-container-system",
        "kcenon-monitoring-system"
      ]
    },
    "postgresql": {
      "description": "Enable PostgreSQL database support",
      "dependencies": [
        {
          "name": "libpq"
        },
        {
          "name": "libpqxx",
          "default-features": false
        },
        {
          "name": "openssl",
          "version>=": "3.0.0"
        }
      ]
    },
    "mysql": {
      "description": "Enable MySQL database support",
      "dependencies": [
        {
          "name": "libmysql"
        }
      ]
    },
    "sqlite": {
      "description": "Enable SQLite database support",
      "dependencies": [
        {
          "name": "sqlite3"
        }
      ]
    },
    "mongodb": {
      "description": "Enable MongoDB backend (experimental)",
      "dependencies": [
        {
          "name": "mongo-cxx-driver"
        }
      ]
    },
    "redis": {
      "description": "Enable Redis backend (experimental)",
      "dependencies": [
        {
          "name": "hiredis"
        }
      ]
    },
    "testing": {
      "description": "Enable unit testing and benchmarking",
      "dependencies": [
        {
          "name": "gtest",
          "features": ["gmock"]
        },
        {
          "name": "benchmark"
        }
      ]
    },
    "samples": {
      "description": "Enable sample applications",
      "dependencies": [
        {
          "name": "fmt",
          "version>=": "10.2.1"
        }
      ]
    },
    "logging": {
      "description": "Enable advanced logging capabilities",
      "dependencies": [
        {
          "name": "spdlog",
          "features": ["fmt-external"]
        }
      ]
    },
    "development": {
      "description": "Enable all development tools and database backends",
      "dependencies": [
        {
          "name": "gtest",
          "features": ["gmock"]
        },
        {
          "name": "benchmark"
        },
        {
          "name": "spdlog",
          "features": ["fmt-external"]
        }
      ]
    }
  }
}
